
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Regular Members | ST.FITTER GYM</title>
    
    
    <link rel="stylesheet" href="/adminRegularMemberList.css">
</head>
<body>

    <!-- HEADER -->
    <header class="admin-header">
        <h1>ST.<span>FITTER</span> GYM</h1>

        <form action="/adminLogout" method="POST"
              onsubmit="return confirm('Are you sure you want to log out?');">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </header>

    <main class="admin-container">

        <!-- NAVIGATION CARDS -->
        <section>
            <h2 class="section-title">Admin Dashboard</h2>

            <div class="dashboard-links">

                <a href="/adminAttendanceList" class="dashboard-link">
                    Today's Attendance
                    <span>View today's gym attendance Regular</span>
                </a>

                <a href="/adminWalkinList" class="dashboard-link">
                    Walk-in List
                    <span>View walk-in registration records</span>
                </a>

                <a href="/adminRegularMemberList"
                   class="dashboard-link active">
                    Regular Members 
                    <span>View registered gym members</span>
                </a>

            </div>
        </section>

        <!-- REGULAR MEMBERS CONTENT -->
        <section class="regular-members-content">

            <div class="members-heading">
                <div>
                    <h2>Regular Members</h2>
                    <p>Manage registered gym members and membership payments.</p>
                </div>

                <a href="/adminIndex" class="members-btn">
                    + Register Member
                </a>
            </div>

            <!-- SEARCH -->
            <section class="members-search">
                <h3>Search Members</h3>

                <form action="/adminRegularMemberList/search" method="GET">
                    <input
                        type="text"
                        name="search"
                        placeholder="Enter first name or last name"
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                    >

                    <button type="submit" class="members-btn">
                        Search
                    </button>

                    <a href="/adminRegularMemberList"
                       class="members-btn secondary">
                        Show All
                    </a>
                </form>
            </section>

            <!-- MEMBERS TABLE -->
            <div class="members-table-wrapper">
                <table class="members-table">

                    <thead>
                        <tr>
                            <th>Member ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Age</th>
                            <th>Contact</th>
                            <th>Months Available</th>
                            <th>Total Payment</th>
                            <th>Payment Status</th>
                            <th>Starting Date</th>
                            <th>Expiry Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (member && member.length > 0) { %>

                            <% member.forEach(function(data) { %>
                                <tr>
                                    <td data-label="Member ID"><%= data.id %></td>
                                    <td data-label="First Name"><%= data.firstname %></td>
                                    <td data-label="Last Name"><%= data.lastname %></td>
                                    <td data-label="Age"><%= data.age %></td>
                                    <td data-label="Contact"><%= data.contact || '' %></td>
                                    <td data-label="Months Available"><%= data.months_avail %></td>
                                    <td data-label="Total Payment">₱<%= data.total_payment %></td>
                                    <td data-label="Payment Status"><%= data.payment_status %></td>
                                    <td data-label="Available Date"><%= data.avail_date %></td>
                                    <td data-label="Expiry Date"><%= data.expire_date %></td>

                                    <td data-label="Action" class="action-links">
                                        <a href="/edit/<%= data.id %>">Edit</a>

                                        <a href="/delete/<%= data.id %>"
                                           onclick="return confirm('Are you sure you want to delete this member?')">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>

                        <% } else { %>

                            <tr>
                                <td colspan="11" class="no-members">
                                    No regular members found.
                                </td>
                            </tr>

                        <% } %>
                    </tbody>

                </table>
            </div>

        </section>

    </main>

</body>
</html>
