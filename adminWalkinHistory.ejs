<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Walk-in History | ST.FITTER GYM</title>

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/adminwalkinhistory.css">
</head>
<body>

    <header class="admin-header">
        <h1>ST.<span>FITTER</span> GYM</h1>

        <a href="/adminIndex" class="history-back">
            Back to Dashboard
        </a>
    </header>

    <main class="history-container">
              <!-- NAVIGATION CARDS -->
        <section>
            <h2 class="section-title">Admin Dashboard</h2>

            <div class="dashboard-links">

                <a href="/adminAttendanceList" class="dashboard-link">
                    Today's Attendance
                    <span>View today's gym attendance Regular</span>
                </a>

                <a href="/adminWalkinList" class="dashboard-link">
                    Walk-in List
                    <span>View walk-in registration records</span>
                </a>

                <a href="/adminRegularMemberList"
                   class="dashboard-link active">
                    Regular Members 
                    <span>View registered gym members</span>
                </a>

            </div>
        </section>

        <div class="history-heading">
            <h2>Walk-in History</h2>
            <p>View previous walk-in registration records.</p>

        </div>

        <div class="attendance-table-wrapper">
            <table class="attendance-table">

                <thead>
                    <tr>
                        <th>Walk-in ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Age</th>
                        <th>Contact</th>
                        <th>Date and Time</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (walkins && walkins.length > 0) { %>

                        <% walkins.forEach(function(walkin) { %>
                            <tr>
                                <td data-label="Walk-in ID">
                                    <%= walkin.id %>
                                </td>

                                <td data-label="First Name">
                                    <%= walkin.firstname %>
                                </td>

                                <td data-label="Last Name">
                                    <%= walkin.lastname %>
                                </td>

                                <td data-label="Age">
                                    <%= walkin.age %>
                                </td>

                                <td data-label="Contact">
                                    <%= walkin.contact || '' %>
                                </td>

                                <td data-label="Date and Time">
                                    <%= walkin.visit_date || '' %>
                                </td>
                            </tr>
                        <% }); %>

                    <% } else { %>
                        <tr>
                            <td colspan="6" class="empty-attendance">
                                No walk-in history records found.
                            </td>
                        </tr>
                    <% } %>
                </tbody>

            </table>
        </div>

    </main>

</body>
</html>