<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/adminRegularMemberList.css">

    <title>Today's Attendance | ST.FITTER GYM</title>

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/adminAttendanceList.css">
</head>

<body>

    <!-- HEADER -->
    <header class="admin-header">
        <h1>ST.<span>FITTER</span> GYM</h1>

        <form action="/adminLogout" method="POST" onsubmit="return confirm('Are you sure you want to log out?');">
            <button type="submit" class="logout-btn">Logout</button>
        </form>
    </header>

    <main class="admin-container">

        <!-- DASHBOARD NAVIGATION -->
        <section>
            <h2 class="section-title">Admin Dashboard</h2>

            <div class="dashboard-links">

                <a href="/adminAttendanceList" class="dashboard-link active">
                    Today's Attendance
                    <span>View today's gym attendance</span>
                </a>

                <a href="/adminWalkinList" class="dashboard-link">
                    Walk-in List
                    <span>View walk-in registration records</span>
                </a>

                <a href="/adminRegularMemberList" class="dashboard-link">
                    Regular Members
                    <span>View registered gym members</span>
                </a>

            </div>
        </section>

        <section class="attendance-content">

            <div class="attendance-heading">
                <div>
                    <h2>Today's Regular Member Attendance</h2>
                    <p>View regular members who checked in today.</p>
                </div>

                <a href="/adminAttendanceHistory" class="dashboard-button" role="button">
                    Attendance History
                    <span>View previous attendance records</span>
                </a>
            </div>

            <div class="attendance-table-wrapper">
                <table class="attendance-table">
                    <thead>
                        <tr>
                            <th>Attendance ID</th>
                            <th>Member ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Check In</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (attendance && attendance.length > 0) { %>

                            <% attendance.forEach(function(row) { %>
                                <tr>
                                    <td data-label="Attendance ID">
                                        <%= row.attendance_id %>
                                    </td>
                                    <td data-label="Member ID">
                                        <%= row.member_id %>
                                    </td>
                                    <td data-label="First Name">
                                        <%= row.firstname %>
                                    </td>
                                    <td data-label="Last Name">
                                        <%= row.lastname %>
                                    </td>
                                    <td data-label="Check In">
                                        <%= row.check_in %>
                                    </td>
                                </tr>
                            <% }); %>

                        <% } else { %>
                            <tr>
                                <td colspan="5" class="empty-attendance">
                                    No attendance records for today.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </section>

    </main>

</body>

</html>